# The deployed API origin the Next server proxies /v1 and /r to (server-side
# rewrite = same-origin in the browser, so no CORS needed). Set this to your
# Railway API public URL in production, e.g. https://ralia-api-xxxx.up.railway.app
API_ORIGIN=http://localhost:6100

# Where "Sign up as a promoter" sends people — the promoter app's public URL.
# In dev locally that's :6400; in a deployment set it to the promoter Vercel URL.
NEXT_PUBLIC_PROMOTER_URL=http://localhost:6400

# Environment badge shown in the corner of the app (local | dev | staging).
# Anything else (or "production") hides the badge. Set per environment on Vercel.
NEXT_PUBLIC_APP_ENV=local

# Meta (Facebook) Pixel id for conversion tracking. PUBLIC — same number as the
# backend's META_DATASET_ID. Safe to ship. Leave blank to disable the Pixel. The
# CAPI access token is a SERVER secret and never belongs in any NEXT_PUBLIC_ var.
NEXT_PUBLIC_META_PIXEL_ID=

NODE_ENV=production
