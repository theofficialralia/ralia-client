# The API origin the Next dev server proxies /v1 and /r to.
API_ORIGIN=http://localhost:3000

# Paystack public key (pk_test_… in dev). Card details are entered in Paystack's
# own popup, so only the public key lives here; the secret key stays on the API.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY
